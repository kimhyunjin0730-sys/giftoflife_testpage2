{
  "name": "golikorea-next",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "sync-legacy": "node -e \"require('fs').copyFileSync('../index.html', 'public/index.html'); console.log('Synced ../index.html → public/index.html')\"",
    "predev": "npm run sync-legacy",
    "prebuild": "npm run sync-legacy",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.0.3",
    "typescript": "^5.6.3"
  }
}
